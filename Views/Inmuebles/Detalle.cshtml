@model Portal_inmobiliario.Models.Inmueble

@{
    ViewData["Title"] = Model.Titulo;
}

<h1>@Model.Titulo</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <img src="@(Model.Imagen ?? "/images/default.jpg")" class="img-fluid rounded" alt="@Model.Titulo">
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Información Clave</h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>Precio:</strong> @Model.Precio.ToString("C")</li>
                    <li class="list-group-item"><strong>Ciudad:</strong> @Model.Ciudad</li>
                    <li class="list-group-item"><strong>Dirección:</strong> @Model.Direccion</li>
                    <li class="list-group-item"><strong>Tipo:</strong> @Model.Tipo</li>
                    <li class="list-group-item"><strong>Superficie:</strong> @Model.MetrosCuadrados m²</li>
                    <li class="list-group-item"><strong>Dormitorios:</strong> @Model.Dormitorios</li>
                    <li class="list-group-item"><strong>Baños:</strong> @Model.Banos</li>
                </ul>
            </div>
            <div class="card-footer text-center">
                <!-- Este botón será implementado en la Pregunta 3 -->
                <a class="btn btn-success btn-lg">Agendar Visita</a>
            </div>
        </div>
    </div>
</div>


<div class="mt-4">
    <a asp-action="Catalogo">Volver al Catálogo</a>
</div> 